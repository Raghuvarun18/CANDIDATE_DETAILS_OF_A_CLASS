print("   **** STUDENT DETAILS OF A CLASS ****   ")
lists = []

while True:
    print("\n")
    print("1.to add new student details.\n2.to see the student details.\n3.to delete the candidate details.\n4.to exit. ")
    choice = int(input("enter your choice(1,2,3 and 4): "))
    
    if choice == 1:
        name = input("enter the name of the candidate: ")
        age = int(input("enter the age of the candidate: "))
        marks = int(input("enter the marks of the candidate: "))

        new_candidate = {"name": name, "age": age, "marks": marks}
        lists.append(new_candidate)
        print(f"{name} details have been added successfully.")
        
    elif choice == 2:
        print("1.to see student detais with name .\n2.to see the total students details ")
        search=int(input("enter your choice :"))
        if search == 1:
            if len(lists) == 0:
                print("list is empty, please add candidate details first.")
            else :
                search_name = input("enter the name of the student ")
                if name == search_name :
                    print(f" Name: {name}, Age: {age}, Marks: {marks}")
        else:
            if len(lists) == 0:
                print("list is empty, please add candidate details first.")
            else :
        	    for number, i in enumerate(lists, 1):
        	       print(f"{number} . Name: {i['name']}, Age: {i['age']}, Marks: {i['marks']}")
        
    
    elif choice == 3:
        if len(lists) == 0:
            print("No candidates available to delete.")
            continue
        for number, i in enumerate(lists, 1):
            print(f"{number} . Name: {i['name']}, Age: {i['age']}, Marks: {i['marks']}")
        delete = int(input("enter the number of the candidate details you want to delete: "))
        removed_candidate = lists.pop(delete - 1)
        print(f"{removed_candidate['name']} details have been removed successfully.")
           
    elif choice == 4:
        print("exit")
        break
    else:
        print("Invalid choice! Please enter a number between 1 and 5.")
